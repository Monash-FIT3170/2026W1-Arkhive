GEMINI_API_KEY = your_gemini_api_key_here
endpoint = your_azure_endpoint_url_here
AZURE_CLOUD_API_KEY = your_azure_api_key_here

# Set to "mock" to skip real Azure/Gemini OCR calls and return a fixed
# fixture instead. Used by CI and integration tests; also handy for local
# dev without real Azure/Gemini keys.
OCR_MODE = 

#FRONTEND superbase
VITE_SUPABASE_URL= suparbase_endpoint_here
VITE_SUPABASE_ANON_KEY=anon_key_here

#Backend R2 + Superbase
R2_ACCOUNT_ID = account_id
R2_ACCESS_KEY_ID = access_Key_r2
R2_SECRET_ACCESS_KEY = secret_access_key_r2
R2_BUCKET_NAME = bucket_name
SUPABASE_URL = suparbase_endpoint_here
SUPABASE_SERVICE_ROLE_KEY = service_role_key